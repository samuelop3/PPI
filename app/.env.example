# Configuración de EmailJS para envío automático de notificaciones a Gmail

# 1. Registrate en https://www.emailjs.com/ (es GRATIS)
# 2. Obtén tu PUBLIC_KEY en https://dashboard.emailjs.com/admin/account
# 3. Configura Gmail como servicio de correo
# 4. Copia estos valores en un archivo .env.local

# Tu clave pública de EmailJS (obligatoria)
VITE_EMAILJS_PUBLIC_KEY=tu_public_key_aqui

# Tu ID de servicio Gmail (ej: gmail_YOUR_ID)
VITE_EMAILJS_SERVICE_ID=tu_service_id_aqui

# Tu ID de plantilla (ej: template_YOUR_ID)
VITE_EMAILJS_TEMPLATE_ID=tu_template_id_aqui

# Nota: Si no configuras estas variables, el sistema simulará el envío en desarrollo
# Pero los correos NO se enviarán a Gmail. Sigue los pasos abajo para configurar.
