# Configuración de EmailJS para envío automático de notificaciones

# Para usar envío de correos automáticos real, registrate en https://www.emailjs.com/

# Tu clave pública de EmailJS
VITE_EMAILJS_PUBLIC_KEY=YOUR_PUBLIC_KEY

# Tu ID de servicio de correo (ej: gmail, outlook, etc)
VITE_EMAILJS_SERVICE_ID=YOUR_SERVICE_ID

# Tu ID de plantilla de correo
VITE_EMAILJS_TEMPLATE_ID=YOUR_TEMPLATE_ID

# Actualmente, la app usa simulación de envíos guardados en localStorage
# Esto funciona para desarrollo sin necesidad de configurar EmailJS
